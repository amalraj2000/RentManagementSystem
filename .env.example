# Turso (libSQL) — create with: turso db create pg-manager ; turso db show pg-manager --url ; turso db tokens create pg-manager
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# Public URL of the deployed app (used for same-origin checks). e.g. https://pg.example.com
APP_URL=http://localhost:3000

# Random string (e.g. `openssl rand -hex 32`). Vercel Cron sends it as a Bearer token to /api/cron/reminders (daily due/overdue notifications).
CRON_SECRET=

# Only used by `npm run admin:create` (one-off provisioning). Do NOT set these in Vercel.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
